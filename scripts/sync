# sync: copy the shared tooling files into a consumer repository.
#
# usage: sync [--check]
#
# Run the script from the root of a consumer repository. It copies
# every file of the packs that the consumer selects into the same
# path of the consumer, with the file mode of the source. A pack is
# one sync tree of the Tooling checkout: `org` is org/sync/ and every
# consumer takes it, `perl` is perl/sync/ for the Perl repositories,
# and `infra` is infra/sync/ for the repositories with OpenTofu code.
# The consumer selects its packs with `sync.pack` lines in .toolingrc;
# with no such line the consumer takes the org pack only. With
# --check the script changes nothing: it reports every file that is
# missing, differs in content, or differs in the exec bit, and exits
# non-zero when it found any. CI runs --check as the drift gate.
#
# The script resolves the Tooling root from its own location, so it
# takes no argument. It refuses to run outside a consumer: the
# consumer root must hold a .toolingrc file.
#
# Like scripts/deps, this script is bootstrap tooling: core modules
# only, and v5.34 because macOS still ships perl 5.34.

use v5.34;
use warnings;
use experimental 'signatures';

use Cwd            qw(getcwd);
use File::Find     ();
use File::Path     qw(make_path);
use File::Copy     qw(copy);
use File::Spec     ();
use File::Basename qw(dirname);
use Getopt::Long   qw(GetOptions);

my $check;
GetOptions( 'check' => \$check ) or die "usage: sync [--check]\n";

my $tooling = Cwd::abs_path(
	File::Spec->catdir(
		dirname( File::Spec->rel2abs(__FILE__) ),
		File::Spec->updir
	) );

my %PACKS = (
	org   => File::Spec->catdir( $tooling, 'org',   'sync' ),
	perl  => File::Spec->catdir( $tooling, 'perl',  'sync' ),
	infra => File::Spec->catdir( $tooling, 'infra', 'sync' ),
);

my $target = getcwd();
$target ne $tooling
    or die "sync: run from a consumer repository, not from Tooling\n";
my $rc = File::Spec->catfile( $target, '.toolingrc' );
-f $rc or die "sync: no .toolingrc in $target (run from a consumer root)\n";

my @packs;
open my $rcfh, '<', $rc or die "sync: read .toolingrc: $!\n";
while ( my $line = <$rcfh> ) {
	next unless $line =~ /^sync\.pack\s+(\S+)/;
	my $pack = $1;
	$PACKS{$pack} or die "sync: unknown pack in .toolingrc: $pack\n";
	push @packs, $pack;
}
close $rcfh;
@packs = ('org') unless @packs;

my @sources = map { $PACKS{$_} } @packs;
-d $_ or die "sync: cannot find $_\n" for @sources;

# _slurp($path):
#	Whole file as bytes, or die.
sub _slurp ($path)
{
	open my $fh, '<:raw', $path or die "sync: read $path: $!\n";
	local $/ = undef;
	my $content = <$fh>;
	close $fh;

	return $content;
}

my %manifest;
for my $source (@sources) {
	File::Find::find( {
			wanted => sub {
				return unless -f $_;
				my $path =
				    File::Spec->abs2rel( $File::Find::name,
					$source );
				die "sync: $path is in two packs\n"
				    if exists $manifest{$path};
				$manifest{$path} = $source;
			},
			no_chdir => 1,
		},
		$source
	);
}
my @manifest = sort keys %manifest;
@manifest or die "sync: nothing to sync\n";

my @drift;
for my $path (@manifest) {
	my $from = File::Spec->catfile( $manifest{$path}, $path );
	my $to   = File::Spec->catfile( $target,          $path );
	my $mode = ( stat $from )[2] & 0777;

	if ($check) {
		if ( !-f $to ) {
			push @drift, "$path: missing";
			next;
		}
		if ( _slurp($from) ne _slurp($to) ) {
			push @drift, "$path: content differs";
			next;
		}
		my $exec_from = $mode & 0111               ? 1 : 0;
		my $exec_to   = ( ( stat $to )[2] & 0111 ) ? 1 : 0;
		push @drift, "$path: exec bit differs"
		    if $exec_from != $exec_to;
		next;
	}

	my ( undef, $dir ) = File::Spec->splitpath($to);
	make_path($dir);
	copy( $from, $to ) or die "sync: copy $path: $!\n";
	chmod $mode, $to or die "sync: chmod $path: $!\n";
	say "synced $path";
}

if ($check) {
	if (@drift) {
		say STDERR "sync: drift against $tooling:";
		say STDERR "  $_" for @drift;
		exit 1;
	}
	say 'sync: no drift';
}
